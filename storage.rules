rules_version = '2';

// Oppgave-PDF-er for SEB-prøver.
// - Ingen klient kan skrive (alt skrives av Cloud Function createSebExam med Admin SDK).
// - Oppgave-PDF inneholder ingen elevdata eller sensitiv informasjon.
// - Elever kan lese oppgaven hvis de kjenner den nøyaktige 20-tegns prøve-ID-en.
// - Listing er sperret for alle.
service firebase.storage {
  match /b/{bucket}/o {
    match /sebExams/{examId}/oppgave.pdf {
      // Tillat kun lesing så lenge oppgave-PDF-en ikke har passert 90-dagersfristen (TTL).
      // Bruker filens eget opprettelsestidspunkt i Storage (ingen kryss-oppslag mot Firestore).
      allow get: if resource != null && request.time < resource.timeCreated + duration.value(90, 'd');
      allow list, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
