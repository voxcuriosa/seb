rules_version = '2';

// Oppgave-PDF-er for SEB-prøver.
// - Ingen klient kan skrive (alt skrives av Cloud Function createSebExam med Admin SDK).
// - Oppgave-PDF inneholder ingen elevdata eller sensitiv informasjon.
// - Elever kan lese oppgaven hvis de kjenner den nøyaktige 20-tegns prøve-ID-en.
// - Listing er sperret for alle.
service firebase.storage {
  match /b/{bucket}/o {
    match /sebExams/{examId}/oppgave.pdf {
      allow get: if true;
      allow list, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
